{
  "name": "chatterpilot",
  "private": true,
  "description": "Local-first toolkit that turns WhatsApp order messages into source-linked drafts you can check and export.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "chatterpilot": "node apps/local/src/cli.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/local/web/tsconfig.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:quick": "pnpm lint && pnpm typecheck && vitest run --changed",
    "build:web": "vite build --config apps/local/web/vite.config.ts",
    "demo": "pnpm build:web && node apps/local/src/cli.ts demo",
    "test:e2e": "pnpm build:web && playwright test --config apps/local/e2e/playwright.config.ts",
    "bench": "node apps/local/src/bench.ts",
    "media": "pnpm build:web && node apps/local/src/media/record.ts",
    "media:render": "node apps/local/src/media/render.ts",
    "media:tour": "node apps/local/src/media/serve-tour.ts",
    "agent-reference": "node apps/local/src/agent-reference.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
