{
  "name": "ChatterPilot",
  "image": "node:22-bookworm",
  "postCreateCommand": "npm install -g pnpm@12.14.0 && pnpm install --frozen-lockfile && pnpm check",
  "forwardPorts": [4317],
  "portsAttributes": {
    "4317": { "label": "ChatterPilot review app", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome"]
    }
  }
}
